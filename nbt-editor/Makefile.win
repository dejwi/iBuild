# Makefile for compiling a Windows shared library (DLL) using MinGW-w64

# Use the 64-bit MinGW-w64 gcc
CC = x86_64-w64-mingw32-gcc

BUILD_DIR = build

# Compilation flags. Note: -shared is needed only at link time.
CFLAGS = -I. -m64 -D_DLL -D_USRDLL -DWIN32 -D_WIN32 -DZF_LOG_DEF_LEVEL=ZF_LOG_DEBUG
# Linker flags (for output options)
LDFLAGS = -shared -m64 -Wl,--out-implib,$(BUILD_DIR)/libmc.a
# Libraries to link (placed after object files)
LDLIBS = -lws2_32 -lz

DEPS = mc.h
# Exclude main.c from the list of source files.
SRC = $(filter-out main.c, $(wildcard *.c))
OBJ = $(SRC:%.c=$(BUILD_DIR)/%.o)

# Default target builds the shared library for Windows (.dll).
all: $(BUILD_DIR)/libmc.dll

# Create the build directory if it doesn't exist
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# Compile each .c file into an object file in the build directory
$(BUILD_DIR)/%.o: %.c $(DEPS) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c -o $@ $<

# Link all object files into a Windows DLL
$(BUILD_DIR)/libmc.dll: $(OBJ)
	$(CC) $(LDFLAGS) -o $@ $^ $(LDLIBS)

# Clean command
clean:
	del $(BUILD_DIR)
